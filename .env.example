# ==============================================================================
# Zendesk Support Intelligence Platform — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Zendesk API Integration
# ------------------------------------------------------------------------------
# ZENDESK_SUBDOMAIN: Subdomain portion of your Zendesk tenant (e.g. 'acme' for 'acme.zendesk.com')
ZENDESK_SUBDOMAIN=your_subdomain

# ZENDESK_EMAIL: Zendesk agent or administrator account email
ZENDESK_EMAIL=agent@yourcompany.com

# ZENDESK_API_TOKEN: Generated in Admin Center > Apps and integrations > Zendesk API
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# ZENDESK_WEBHOOK_SECRET: Shared secret key for verifying HMAC-SHA256 signatures on inbound webhooks
ZENDESK_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ------------------------------------------------------------------------------
# 2. Database & Persistent Storage (PostgreSQL & SQLite)
# ------------------------------------------------------------------------------
# PostgreSQL (Production):
DATABASE_URL=postgresql+asyncpg://zendesk_app:zendesk_secure_pass_2026@localhost:5432/zendesk_intelligence

# SQLite (Local Development):
# DATABASE_URL=sqlite+aiosqlite:///./data/zendesk_summarizer.db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Background Task Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Security, JWT & Authentication
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: Cryptographic secret key used to sign access tokens (Change in production!)
JWT_SECRET_KEY=change_this_to_a_random_32_byte_secret_in_production

# JWT_ALGORITHM: Signature algorithm
JWT_ALGORITHM=HS256

# JWT_EXPIRATION_HOURS: Token lifespan in hours
JWT_EXPIRATION_HOURS=24

# ENABLE_PII_REDACTION: Redact credit cards, SSNs, and passwords before AI transmission
ENABLE_PII_REDACTION=true

# RATE_LIMIT_PER_MINUTE: Sliding-window rate limit per client IP or user per 60s
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 5. Multi-Provider AI Orchestration Configuration
# ------------------------------------------------------------------------------
# LLM_PROVIDER: Primary AI provider ('gemini', 'groq', 'openai', 'anthropic')
LLM_PROVIDER=gemini

# Google Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud API (Ultra-low latency fallback / primary):
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# 6. Service & Operational Settings
# ------------------------------------------------------------------------------
DEFAULT_SUMMARY_STYLE=standard
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
