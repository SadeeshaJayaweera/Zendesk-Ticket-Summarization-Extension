# ==============================================================================
# Zendesk Ticket Summarizer - Environment Configuration
# ==============================================================================

# Zendesk Configuration
# ---------------------
# ZENDESK_SUBDOMAIN: The subdomain part of your Zendesk URL (e.g. 'mycompany' for 'https://mycompany.zendesk.com')
ZENDESK_SUBDOMAIN=your_zendesk_subdomain

# ZENDESK_EMAIL: The email address of the agent or admin user
ZENDESK_EMAIL=agent@example.com

# ZENDESK_API_TOKEN: Zendesk API Token generated under Admin Center > Apps and integrations > Zendesk API
# Note: Basic Auth uses username '{ZENDESK_EMAIL}/token' and password '{ZENDESK_API_TOKEN}'
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# Google Gemini AI Configuration
# ------------------------------
# GEMINI_API_KEY: API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Model to use for ticket summarization (e.g., gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Backend Service Configuration (Optional)
# ----------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
